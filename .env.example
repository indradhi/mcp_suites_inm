# ─────────────────────────────────────────────────────────────────
#  MCP Knowledge Server — Environment Configuration
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────

# ── Path Configuration ────────────────────────────────────────────
# Optional: Set this to a specific path to store data elsewhere in production
# DATA_DIR=/path/to/production/data

# ── MySQL ─────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=ChangeMeRootPass!2025
MYSQL_DATABASE=mcp_knowledge
MYSQL_USER=mcp_user
MYSQL_PASSWORD=ChangeMeDbPass!2025

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── ChromaDB ──────────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=knowledge_base

# ── Neo4j ─────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ChangeMeNeo4j!2025

# ── JWT Auth ──────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE-ME-TO-RANDOM-256BIT-HEX-STRING-NOW
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Encryption (Fernet key for stored credentials) ────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=CHANGE-ME-RUN-ABOVE-COMMAND

# ── LLM Backend (default — pre-seeded at startup) ─────────────────
OPENAI_API_BASE=http://172.16.21.122:18000/v1
OPENAI_API_KEY=sk-IrR7Bwxtin0haWagUnPrBgq5PurnUz86
OPENAI_MODEL=Qwen/Qwen3-32B-FP8

# ── Embeddings (local sentence-transformers, no API key needed) ────
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Set to "openai" to use OpenAI-compatible embeddings endpoint instead
EMBEDDINGS_PROVIDER=local

# ── Web Search ────────────────────────────────────────────────────
# Provider: tavily | duckduckgo
WEB_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# ── Backoffice API ────────────────────────────────────────────────
BACKOFFICE_API_HOST=backoffice-api
BACKOFFICE_API_PORT=8001
BACKOFFICE_URL=http://backoffice-api:8001
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# ── MCP Server ────────────────────────────────────────────────────
MCP_SERVER_HOST=mcp-server
MCP_SERVER_PORT=8000

# ── Graph Builder ─────────────────────────────────────────────────
GRAPH_BUILDER_ENABLED=true
# Use LLM for entity enrichment (more accurate, costs tokens)
GRAPH_LLM_ENRICHMENT=true
# Minimum confidence score (0.0–1.0) to store a relationship edge
GRAPH_MIN_CONFIDENCE=0.6
# spaCy model for NER (installed in worker container)
SPACY_MODEL=en_core_web_sm

# ── Backup ────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=7
# Optional: rclone remote path to sync backups (e.g. s3:my-bucket/mcp-backups)
# RCLONE_REMOTE=

# ── Google Drive (Phase 2 — leave commented out for now) ──────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8001/auth/google/callback

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Production Nginx Reverse Proxy Ports ──────────────────────────
# Change if port 80 or 443 is already occupied on your Linux server
PROD_HTTP_PORT=80
PROD_HTTPS_PORT=443
